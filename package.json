{
  "name": "cliptype",
  "version": "1.1.0",
  "private": true,
  "description": "Clipboard to caret: Windows, Niri/Wayland and Chromium/Firefox",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/extension-core.test.cjs",
    "test:browser": "node --test tests/extension-browser.test.cjs",
    "build:extensions": "python scripts/build_extensions.py",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "test:firefox": "node --test tests/firefox-engine.test.cjs",
    "test:firefox:install": "node tests/firefox-install.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "web-ext": "10.8.0"
  }
}
